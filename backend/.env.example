# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI with connection pooling)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/svara?retryWrites=true&w=majority

# Authentication & Admin
ADMIN_NAME=SVARA Admin
ADMIN_EMAIL=admin@svara.in
ADMIN_PASSWORD=Admin@123
JWT_SECRET=replace_with_super_secret_jwt_key_minimum_32_chars_in_production
JWT_EXPIRE=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Virtual Try-On Provider ('gemini' | 'fashn' | 'fal')
VTO_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
FASHN_API_KEY=your_fashn_api_key
FAL_KEY=your_fal_key

# Razorpay Payments & Webhook
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Order & Shipping Configuration
FREE_SHIPPING_THRESHOLD=2000
SHIPPING_COST=99

# ---------------------------------------------------------------
# Sessions ("stay signed in until logout")
# ---------------------------------------------------------------
SESSION_DAYS=365
# Set true only if the frontend and API are on different domains (Vercel + Render etc.)
CROSS_SITE_COOKIES=false
# Email OTP on every sign-in (set false to use password-only login)
LOGIN_EMAIL_OTP=true
# Optional separate secret for OTP hashing (falls back to JWT_SECRET)
OTP_SECRET=

# ---------------------------------------------------------------
# Email (SMTP) — OTPs, order tracking, product & approval mails
# Works with Resend, Amazon SES, Brevo, Gmail app-password, etc.
# ---------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=apikey_or_username
SMTP_PASS=password
EMAIL_FROM=SVARA <no-reply@yourdomain.com>

# ---------------------------------------------------------------
# SMS — phone-number OTP only ('msg91' | 'twilio'; 'console' = dev)
# India needs a DLT-registered sender + template for SMS.
# ---------------------------------------------------------------
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------
# Web Push (generate once with: npm run vapid)
# ---------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# ---------------------------------------------------------------
# Payments: Direct UPI + Cash on Delivery
# ---------------------------------------------------------------
UPI_VPA=yourbusiness@bank
UPI_PAYEE_NAME=SVARA
COD_ENABLED=true
COD_MAX_AMOUNT=10000

# ---------------------------------------------------------------
# Default AI Credits Configuration by Role
# ---------------------------------------------------------------
DEFAULT_USER_CREDITS=0
DEFAULT_SELLER_CREDITS=0
DEFAULT_ADMIN_CREDITS=5

