# SVARA Frontend Environment Variables

# Backend API URL (Leave blank to use Vite proxy in dev, or set full URL in production)
# Example: https://api.svara.fashion
VITE_API_URL=http://localhost:5173

# Razorpay Public Key ID
VITE_RAZORPAY_KEY_ID= svara_sec_987654321_secret

# Contact & Atelier Concierge Information (Rule 3 & Rule 50)
VITE_CONTACT_EMAIL=concierge@svara.fashion
VITE_CONTACT_PHONE=+91 (0) 80 4567 8900
VITE_ATELIER_ADDRESS=SVARA Atelier, Indiranagar, Bengaluru, Karnataka 560038
VITE_INSTAGRAM_URL=https://instagram.com/svara.fashion

# Default AI Welcome Credits for Customer Sign-up
VITE_DEFAULT_USER_CREDITS=0
